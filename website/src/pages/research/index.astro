---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Research" description="Research themes of the XAMI Lab.">
  <div class="container section">
    <h1>Research</h1>
    <p class="muted" style="max-width:50rem;">
      Our research is organised into four themes, all working towards machine intelligence
      that people can understand, question and trust.
    </p>
    <div class="grid">
      {projects.map((p) => (
        <a class="card theme" href={`/research/${p.id}/`}>
          <img src={p.data.card} alt="" loading="lazy" width="640" height="400" />
          <div class="body">
            <h2>{p.data.title}</h2>
            <p class="muted">{p.data.summary}</p>
            <span class="more">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .theme { color: inherit; display: flex; flex-direction: column; }
  .theme:hover { text-decoration: none; }
  .theme img { aspect-ratio: 16 / 10; object-fit: cover; }
  .theme .body { padding: 1.2rem 1.3rem 1.4rem; }
  .theme h2 { font-size: 1.2rem; }
  .theme p { font-size: 0.95rem; }
  .more { font-weight: 600; color: var(--link); font-size: 0.9rem; }
</style>
