---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('code')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects" description="Open-source code, tools and datasets from the XAMI Lab.">
  <div class="container section">
    <h1>Projects</h1>
    <p class="muted" style="max-width:50rem;">
      Open-source code, tools and datasets from our research. Everything here is
      available on GitHub or PhysioNet for the community to use and build on.
    </p>

    <div class="grid">
      {projects.map((p) => (
        <article class="card project">
          <div class="body">
            <h2>{p.data.title}</h2>
            <p class="muted">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="tags">
                {p.data.tags.map((t) => <span class="chip">{t}</span>)}
              </div>
            )}
            <div class="actions">
              <a class="btn btn-ghost small" href={p.data.repo} target="_blank" rel="noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
                &nbsp;Code
              </a>
              {p.data.paper && (
                <a class="btn btn-ghost small" href={p.data.paper} target="_blank" rel="noreferrer">Paper</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .project .body { padding: 1.4rem 1.5rem 1.5rem; display: flex; flex-direction: column; height: 100%; }
  h2 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .project p { font-size: 0.93rem; flex-grow: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
  .chip { font-size: 0.72rem; }
  .actions { display: flex; gap: 0.5rem; }
  .btn.small { padding: 0.3rem 0.9rem; min-height: 38px; font-size: 0.85rem; font-weight: 500; }
</style>
