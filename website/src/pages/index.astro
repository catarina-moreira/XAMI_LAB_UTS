---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Home">
  <section class="hero">
    <div class="container hero-inner">
      <img class="hero-logo" src="/assets/X_Logo.png" alt="" width="220" height="196" loading="eager" />
      <div>
        <p class="kicker">eXplainable Analytics for Machine Intelligence</p>
        <h1>Welcome to the <span class="grad-text">XAMI Lab</span></h1>
        <p class="lede">
          Supporting human-machine collaboration and co-evolution by making machine
          intelligence explainable, transparent, fair and understandable to human
          decision-makers.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/research/">Explore our research</a>
          <a class="btn btn-ghost" href="mailto:xami.initiaive@gmail.com">Work with us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">About us</h2>
      <p style="max-width: 60rem;">
        The Explainable Analytics for Machine Intelligence (XAMI) Lab provides a wide range
        of algorithms, methods and techniques to make machine intelligence explainable,
        transparent, fair and understandable to human decision-makers. To learn more about
        this initiative, meet our <a href="/people/">team</a>, explore our <a href="/research/">research projects</a>, and check our <a href="/publications/">publications</a>. Please <a href="mailto:xami.initiaive@gmail.com">contact us</a> if you are interested in
        collaboration.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Research themes</h2>
      <div class="theme-grid">
        {projects.map((p) => (
          <a class="card theme-card" href={`/research/${p.id}/`}>
            <img src={p.data.card} alt="" loading="lazy" width="640" height="400" />
            <div class="body">
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container mission">
      <div>
        <h2 class="section-title">Our vision</h2>
        <p>
          To support human-machine collaboration and co-evolution by making machine
          intelligence explainable, transparent, fair and understandable to human
          decision-makers.
        </p>
        <h2 class="section-title" style="margin-top:2rem;">Our values</h2>
        <ul>
          <li>Pursuit of excellence</li>
          <li>Creativity and critical thinking</li>
          <li>Diversity and inclusiveness</li>
          <li>Positivity and passion</li>
        </ul>
      </div>
      <div>
        <h2 class="section-title">Our mission</h2>
        <ul>
          <li>
            Create breakthroughs in building explainable analytics for machine intelligence:
            devise new methods to build robust and interpretable models, design theories and
            algorithms to detect biases and provide ethical and fair analyses of machine-learned
            predictions, and develop frameworks and tools for user-centric intelligent
            predictive systems with human-in-the-loop mechanisms.
          </li>
          <li>
            Apply explainable machine intelligence to a wide range of application domains and
            industry sectors to promote innovative and sustainable industrialization.
          </li>
          <li>
            Build collaborative networks and foster multi-stakeholder partnerships in the
            context of explainable machine intelligence.
          </li>
          <li>
            Cultivate young research students to become new generations of career excellence
            achievers in Data Science.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(60rem 30rem at 85% -20%, rgb(46 144 250 / 0.25), transparent 60%),
      radial-gradient(50rem 28rem at 10% 120%, rgb(43 217 161 / 0.18), transparent 60%),
      var(--hero-bg);
    color: var(--hero-text);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .hero-logo { flex: 0 0 auto; width: clamp(120px, 18vw, 220px); height: auto; }
  .kicker {
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }
  .hero h1 { color: #fff; }
  .lede { font-size: 1.15rem; max-width: 42rem; color: #c7d2e0; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  @media (max-width: 700px) {
    .hero-inner { flex-direction: column; text-align: center; }
    .cta { justify-content: center; }
    .kicker { letter-spacing: 0.08em; }
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .theme-card { color: inherit; display: flex; flex-direction: column; }
  .theme-card:hover { text-decoration: none; }
  .theme-card img { aspect-ratio: 16 / 10; object-fit: cover; }
  .theme-card .body { padding: 1.1rem 1.2rem 1.3rem; }
  .theme-card h3 { font-size: 1.1rem; }
  .theme-card p { font-size: 0.92rem; margin: 0; }

  .mission {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .mission li { margin-bottom: 0.6rem; }
</style>
