---
interface Props {
  name: string;
  role?: string;
  school?: string;
  university?: string;
  photo?: string;
  email?: string;
  linkedin?: string;
  homepage?: string;
  uts?: string;
  github?: string;
  scholar?: string;
}

const { name, role, school, university, photo, email, linkedin, homepage, uts, github, scholar } = Astro.props;

const links = [
  { href: homepage, label: `${name}'s homepage`, icon: 'home' },
  { href: uts, label: `${name}'s UTS profile`, icon: 'uts' },
  { href: scholar, label: `${name} on Google Scholar`, icon: 'scholar' },
  { href: github, label: `${name} on GitHub`, icon: 'github' },
  { href: linkedin, label: `${name} on LinkedIn`, icon: 'linkedin' },
  { href: email ? `mailto:${email}` : undefined, label: `Email ${name}`, icon: 'mail' },
].filter((l) => l.href);
---

<article class="card member">
  {photo ? (
    <img class="portrait" src={photo} alt={`Portrait of ${name}`} loading="lazy" width="320" height="320" />
  ) : (
    <div class="portrait placeholder" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" width="45%" height="45%"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4.42 0-8 2.24-8 5v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2c0-2.76-3.58-5-8-5Z" /></svg>
    </div>
  )}
  <div class="body">
    <h3>{name}</h3>
    {role && <p class="role">{role}</p>}
    {(school || university) && (
      <p class="muted affiliation">{[school, university].filter(Boolean).join(', ')}</p>
    )}
    {links.length > 0 && (
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noreferrer" aria-label={l.label} title={l.label}>
              {l.icon === 'home' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h5v-6h4v6h5V9.5" /></svg>
              )}
              {l.icon === 'uts' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V8l7-5 7 5v13" /><path d="M9 21v-4h6v4" /><path d="M9 12h.01M15 12h.01M12 12h.01" /></svg>
              )}
              {l.icon === 'scholar' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 10 6-10 6L2 9Z" /><path d="M6 11.5V17c0 1.5 2.5 3 6 3s6-1.5 6-3v-5.5" /></svg>
              )}
              {l.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
              )}
              {l.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.24 8.31h4.52V23H.24V8.31Zm7.44 0h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.92V23h-4.51v-7.1c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V23H7.68V8.31Z" /></svg>
              )}
              {l.icon === 'mail' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .member { display: flex; flex-direction: column; }
  .portrait {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top center;
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    background: var(--gradient);
  }
  .body { padding: 1rem 1.1rem 1.2rem; }
  h3 { font-size: 1.05rem; margin-bottom: 0.15rem; }
  .role { font-weight: 600; font-size: 0.88rem; margin-bottom: 0.15rem; color: var(--teal); }
  .affiliation { font-size: 0.85rem; margin-bottom: 0.4rem; }
  .links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    color: var(--text-muted);
  }
  .links a:hover { color: var(--link); background: var(--bg-alt); }
  .links svg { width: 18px; height: 18px; }
</style>
